{
  "data_path": "data/data_RL18.feather",
  "drop_columns": ["sm_mean", "sm_var"],
  "train_years": [2007, 2008, 2009, 2010, 2011, 2012, 2013, 2014],
  "val_year": 2015,
  "test_year": 2016,
  "refit_on_train_plus_val": true,
  "seeds": [0, 1, 2],
  "nn": {
    "hidden": 512,
    "emb_dim": 2,
    "lr": 0.002,
    "batch_size": 4096,
    "max_epochs": 30,
    "patience": 3,
    "station_dropout": 0.05,
    "num_threads": 8
  },
  "networks": {
    "nn_aux_emb":        {"residual": false, "spread": "free_abs",    "embedding": true},
    "residual_spread":   {"residual": true,  "spread": "constrained", "embedding": true},
    "abl_no_residual":   {"residual": false, "spread": "constrained", "embedding": true},
    "abl_free_spread":   {"residual": true,  "spread": "free_softplus", "embedding": true},
    "abl_no_embedding":  {"residual": true,  "spread": "constrained", "embedding": false}
  },
  "evaluation": {
    "reference_for_skill": ["raw_ensemble_gauss", "emos_loc"],
    "significance_pairs": [
      ["residual_spread", "emos_loc"],
      ["residual_spread", "nn_aux_emb"],
      ["nn_aux_emb", "emos_loc"],
      ["abl_no_residual", "residual_spread"],
      ["abl_free_spread", "residual_spread"],
      ["abl_no_embedding", "residual_spread"]
    ],
    "dm_hac_lag_days": 5,
    "station_dm_hac_lag": 1,
    "bootstrap_block_days": 7,
    "bootstrap_reps": 10000,
    "pit_bins": 10
  }
}
